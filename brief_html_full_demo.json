        "type": "html",
        "full": true,
        "html": "<div class='f-wrap'><div class='f-kicker'>Ôn tập theo chu kỳ</div><div class='f-row'><div class='f-ring'><svg viewBox='0 0 200 200'><circle class='tr' cx='100' cy='100' r='86'></circle><circle class='pg' id='pg' cx='100' cy='100' r='86'></circle></svg><div class='f-mid'><b id='num'>0</b><span>tuần đã ôn</span></div></div><div class='f-col'><div class='f-chip' id='c1'><b>10 phút</b><span>mỗi ngày</span></div><div class='f-chip' id='c2'><b>3 lần</b><span>nhắc lại mỗi tuần</span></div><div class='f-chip' id='c3'><b>90%</b><span>còn nhớ sau một năm</span></div></div></div></div>",
        "css": ".f-wrap{position:absolute;left:6%;right:6%;top:12%;height:44%;display:flex;flex-direction:column;justify-content:center}.f-kicker{font-size:24px;letter-spacing:.16em;text-transform:uppercase;color:#00d4ff;font-weight:800;margin-bottom:22px}.f-row{display:flex;align-items:center;gap:44px;flex:1;min-height:0}.f-ring{position:relative;width:400px;height:400px;flex:0 0 auto;max-height:100%}.f-ring svg{width:100%;height:100%;transform:rotate(-90deg)}.tr{fill:none;stroke:rgba(200,220,255,.14);stroke-width:8}.pg{fill:none;stroke:#00d4ff;stroke-width:8;stroke-linecap:round;stroke-dasharray:540;stroke-dashoffset:540;filter:drop-shadow(0 0 10px rgba(0,212,255,.55))}.f-mid{position:absolute;inset:0;display:flex;flex-direction:column;align-items:center;justify-content:center;gap:6px}.f-mid b{font-size:104px;font-weight:900;color:#eaf6ff;line-height:1;font-variant-numeric:tabular-nums}.f-mid span{font-size:22px;color:#9bb3c4;letter-spacing:.06em}.f-col{flex:1;display:flex;flex-direction:column;gap:18px;min-width:0}.f-chip{display:flex;flex-direction:column;gap:4px;padding:20px 26px;border-radius:22px;background:rgba(200,220,255,.06);border:1px solid rgba(200,220,255,.14);opacity:0}.f-chip b{font-size:36px;font-weight:800;color:#eaf6ff}.f-chip span{font-size:22px;color:#9bb3c4}",
        "anim": "const p = ease(span(t, 0.2, 2.2));\n$('pg').style.strokeDashoffset = 540 - 540 * p;\n$('num').textContent = Math.round(p * 52);\n$('c1').style.opacity = ease(span(t, 0.6, 1.1));\n$('c2').style.opacity = ease(span(t, 1.0, 1.5));\n$('c3').style.opacity = ease(span(t, 1.4, 1.9));\n"
      }
    },
    {
