      "visual": {
        "type": "html",
        "html": "<div class=\"kicker\">Đường cong trí quên</div><div class=\"chart\"><div class=\"col\"><span class=\"num\" id=\"n1\">100%</span><i class=\"bar\" id=\"b1\"></i><span class=\"lab\">vừa học</span></div><div class=\"col\"><span class=\"num\" id=\"n2\">—</span><i class=\"bar red\" id=\"b2\"></i><span class=\"lab\">1 ngày</span></div><div class=\"col\"><span class=\"num\" id=\"n3\">—</span><i class=\"bar red\" id=\"b3\"></i><span class=\"lab\">7 ngày</span></div></div>",
        "css": ".kicker{font-size:26px;letter-spacing:.14em;text-transform:uppercase;color:#00d4ff;font-weight:800;margin-bottom:30px}.chart{display:flex;align-items:flex-end;gap:26px;height:560px}.col{flex:1;display:flex;flex-direction:column;justify-content:flex-end;align-items:center;height:100%}.bar{display:block;width:100%;border-radius:16px 16px 0 0;background:linear-gradient(180deg,#00d4ff,#0a6b86);height:0}.bar.red{background:linear-gradient(180deg,#ff2e88,#7d1846)}.num{font-size:44px;font-weight:900;color:#eaf6ff;margin-bottom:14px;font-variant-numeric:tabular-nums}.lab{font-size:28px;color:#9bb3c4;margin-top:16px}",
        "anim": "const p1 = ease(span(t, 0.2, 1.1));\n$('b1').style.height = (p1 * 100) + '%';\nconst p2 = ease(span(t, 1.3, 2.3));\n$('b2').style.height = (p2 * 47) + '%';\n$('n2').textContent = p2 > 0.05 ? Math.round(p2 * 47) + '%' : '—';\nconst p3 = ease(span(t, 2.5, 3.6));\n$('b3').style.height = (p3 * 9) + '%';\n$('n3').textContent = p3 > 0.05 ? Math.round(p3 * 9) + '%' : '—';"
      }
    },
