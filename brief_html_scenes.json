        "anim": "const o = ease(span(t, 0.3, 2.0));\nconst i = ease(span(t, 1.2, 2.6));\nconst s1 = sc(250 + o * 310);\n$('r1').style.opacity = o;\n$('r1').style.width = s1 + 'px'; $('r1').style.height = s1 + 'px';\nconst s2 = sc(110 + i * 90);\n$('r2').style.opacity = i;\n$('r2').style.width = s2 + 'px'; $('r2').style.height = s2 + 'px';\n"
