        "html": "<div class='wrap'><div class='kicker'>Trí nhớ tạm thời như bảng trắng</div><div class='grid'><span class='blk'></span><span class='blk'></span><span class='blk'></span><span class='blk'></span><span class='blk'></span><span class='blk'></span><span class='blk'></span><span class='blk'></span><span class='blk'></span><span class='blk'></span><span class='blk'></span><span class='blk'></span><span class='blk'></span><span class='blk'></span><span class='blk'></span><span class='blk'></span><span class='blk'></span><span class='blk'></span><span class='blk'></span><span class='blk'></span><span class='blk'></span><span class='blk'></span><span class='blk'></span><span class='blk'></span></div><div class='badge' id='bd'><span class='t'>Giữ được</span><span class='v'>5–10 phút</span></div></div>",
        "css": ".wrap{height:100%;display:flex;flex-direction:column;justify-content:center;align-items:center}.kicker{font-size:30px;letter-spacing:.14em;text-transform:uppercase;color:#00d4ff;font-weight:800;margin-bottom:10px;text-align:center}.grid{display:grid;grid-template-columns:repeat(8,1fr);gap:16px;width:100%;max-width:1000px;margin-top:14px}.blk{height:86px;border-radius:12px;background:#00d4ff;opacity:0}.badge{display:inline-flex;align-items:center;gap:16px;margin-top:26px;background:rgba(234,246,255,.06);border:2px solid rgba(234,246,255,.16);border-radius:999px;padding:14px 32px;opacity:0}.badge .t{font-size:30px;color:#9bb3c4}.badge .v{font-size:52px;font-weight:800;color:#eaf6ff}",
        "anim": "const blocks = el.querySelectorAll('.blk');\nconst filled = ease(span(t, 0.3, 1.7)) * blocks.length;\nblocks.forEach(function(b, i){\n  const on = i < filled;\n  b.style.opacity = on ? 1 : 0;\n  b.style.background = '#00d4ff';\n  if (on) { const age = filled - i; b.style.opacity = age < 3 ? 0.45 : 1; }\n});\nconst drop = ease(span(t, 1.8, 2.5));\nif (drop > 0) {\n  const keepFrom = Math.floor(blocks.length * 0.75);\n  blocks.forEach(function(b, i){\n    if (i < keepFrom) { b.style.opacity = 1 - drop * 0.85; b.style.background = '#7a2341'; }\n  });\n}\n$('bd').style.opacity = ease(span(t, 1.6, 2.1));\n"
